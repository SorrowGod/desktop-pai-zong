<Application x:Class="DesktopPet.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#F28BA8" />
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#D86485" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFF9FB" />
    <SolidColorBrush x:Key="TextBrush" Color="#3D3440" />
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="MinWidth" Value="84" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="0,4,0,10" />
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="0,4,0,10" />
    </Style>
  </Application.Resources>
</Application>
